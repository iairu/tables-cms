{
  "name": "tables-tauri",
  "version": "1.0.0",
  "description": "TABLES CMS - Tauri + Svelte version",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:website": "cd website && npm run build",
    "build:ssg": "npm run build:website && node scripts/post-build.js",
    "deploy:vercel": "npm run build:ssg && npx vercel --prod --yes",
    "lint": "eslint src --ext .js,.svelte",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "tauri",
    "cms",
    "svelte",
    "ssg",
    "vercel"
  ],
  "author": "TABLES Team",
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-svelte": "^2.46.1",
    "jsdom": "^29.0.1",
    "prettier": "^3.2.5",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "^5.53.12",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.6.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "fuse.js": "^7.1.0",
    "socket.io-client": "^4.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
